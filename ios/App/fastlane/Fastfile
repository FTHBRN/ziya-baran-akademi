default_platform(:ios)

platform :ios do
  desc "Build and upload iOS app to TestFlight and App Store Connect"
  lane :beta do
    require 'base64'

    key_content_decoded = Base64.decode64(ENV["APP_STORE_CONNECT_API_KEY_BASE64"])

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: key_content_decoded,
      is_key_content_base64: false,
      in_house: false
    )

    keychain_name = "ci_keychain"
    keychain_password = "ci_password_123"

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # 1. Certificate (Apple Distribution - default)
    get_certificates(
      api_key: api_key,
      keychain_path: File.expand_path("~/Library/Keychains/#{keychain_name}-db"),
      keychain_password: keychain_password
    )

    # Prevent GUI codesign prompts in headless CI
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k #{keychain_password} #{File.expand_path('~/Library/Keychains/' + keychain_name + '-db')}")

    # 2. Provisioning Profile (App Store - default)
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.ziyabaran.akademi"
    )

    # 3. Update Xcode Project Signing to Manual with Downloaded Profile
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      profile_name: ENV["SIGH_NAME"],
      code_sign_identity: "Apple Distribution",
      bundle_identifier: "com.ziyabaran.akademi"
    )

    # 4. Build & Archive using gym
    build_app(
      scheme: "App",
      project: "App.xcodeproj",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "ziya-baran-akademi.ipa",
      clean: true,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.ziyabaran.akademi" => ENV["SIGH_NAME"]
        }
      }
    )

    # 4. Upload to TestFlight / App Store Connect
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      ipa: "./build/ziya-baran-akademi.ipa"
    )
  end
end
